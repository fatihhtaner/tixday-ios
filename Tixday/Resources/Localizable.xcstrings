    "Add the day you're waiting for and watch it count down on your Home Screen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف اليوم الذي تنتظره وشاهد العد التنازلي على شاشتك الرئيسية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge den Tag hinzu, auf den du wartest, und sieh auf dem Home-Bildschirm zu, wie er näher rückt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el día que esperas y mira la cuenta atrás en tu pantalla de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le jour que vous attendez et regardez le compte à rebours sur votre écran d'accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il giorno che aspetti e guarda il conto alla rovescia nella schermata Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待ち遠しい日を追加して、ホーム画面でカウントダウンしよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기다리는 날을 추가하고 홈 화면에서 카운트다운을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o dia que você está esperando e acompanhe a contagem regressiva na Tela de Início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте день, которого ждёте, и следите за обратным отсчётом на экране «Домой»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklediğin günü ekle, ana ekranında geri saymasını izle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加你期待的日子，在主屏幕上看着它倒数。"
          }
        }
      }
    },
