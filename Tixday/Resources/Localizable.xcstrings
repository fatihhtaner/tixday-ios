    "Counts down to a date. Edit the widget to pick a ticket.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عد تنازلي حتى تاريخ معيّن. عدّل الأداة لاختيار تذكرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt die Tage bis zu einem Datum. Bearbeite das Widget, um ein Ticket zu wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta atrás hasta una fecha. Edita el widget para elegir un boleto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte à rebours jusqu'à une date. Modifiez le widget pour choisir un billet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conto alla rovescia fino a una data. Modifica il widget per scegliere un biglietto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付までカウントダウン。ウィジェットを編集してチケットを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜까지 카운트다운합니다. 위젯을 편집해 티켓을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagem regressiva até uma data. Edite o widget para escolher um ingresso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратный отсчёт до даты. Измените виджет, чтобы выбрать билет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tarihe geri sayar. Bilet seçmek için widget'ı düzenle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倒数到某个日期。编辑小组件以选择票券。"
