      "shouldTranslate": false
    },
    "%@": {
      "shouldTranslate": false
    },
    "%@ a year. Cancel anytime in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سنويًا. ألغِ في أي وقت من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Jahr. Jederzeit in den Einstellungen kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al año. Cancela cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par an. Résiliable à tout moment dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ all'anno. Annulla quando vuoi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年額%@。設定からいつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연 %@. 설정에서 언제든 해지할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por ano. Cancele quando quiser em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ в год. Отменить можно в любой момент в Настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıllık %@. İstediğin zaman Ayarlar'dan iptal et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每年 %@。可随时在设置中取消。"
          }
        }
      }
    },
