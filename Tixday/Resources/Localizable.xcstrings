    "Show one ticket, or leave empty to always show the next one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض تذكرة واحدة، أو اتركها فارغة لعرض التذكرة التالية دائمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige ein bestimmtes Ticket oder lass das Feld leer, um immer das nächste zu zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un boleto, o déjalo vacío para mostrar siempre el siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez un billet précis, ou laissez vide pour toujours afficher le prochain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un biglietto, oppure lascia vuoto per vedere sempre il prossimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1枚のチケットを表示します。空欄にすると常に次のチケットを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "티켓 하나를 표시하거나, 비워 두면 항상 다음 티켓을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre um ingresso, ou deixe em branco para sempre mostrar o próximo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать один билет или оставить пустым, чтобы всегда показывать ближайший."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir bileti göster ya da her zaman en yakın bileti göstermek için boş bırak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示一张票券，留空则始终显示下一张。"
          }
        }
      }
    },
