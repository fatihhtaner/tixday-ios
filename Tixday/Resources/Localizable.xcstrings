    "A month, a week and a day before, and on the day.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ay, bir hafta ve bir gün önce, bir de o gün."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Monat, eine Woche und einen Tag vorher sowie am Tag selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mois, une semaine et un jour avant, puis le jour J."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mes, una semana y un día antes, y el mismo día."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mese, una settimana e un giorno prima, e il giorno stesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mês, uma semana e um dia antes, e no próprio dia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1か月前、1週間前、前日、そして当日に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 달 전, 일주일 전, 하루 전, 그리고 당일에."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提前一个月、一周、一天，以及当天。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За месяц, за неделю, за день и в сам день."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل شهر وأسبوع ويوم، وفي اليوم نفسه."
          }
        }
      }
    },
