    "Free for the trial, then %@ a year. Cancel anytime in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجاني خلال التجربة، ثم %@ سنويًا. ألغِ في أي وقت من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Testphase gratis, danach %@ pro Jahr. Jederzeit in den Einstellungen kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis durante la prueba, luego %@ al año. Cancela cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pendant l'essai, puis %@ par an. Résiliable à tout moment dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis durante la prova, poi %@ all'anno. Annulla quando vuoi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お試し期間は無料、その後は年額%@。設定からいつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험 기간 동안 무료, 이후 연 %@. 설정에서 언제든 해지할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis no período de teste, depois %@ por ano. Cancele quando quiser em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно на пробный период, затем %@ в год. Отменить можно в любой момент в Настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme boyunca ücretsiz, sonra yıllık %@. İstediğin zaman Ayarlar'dan iptal et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用期免费，之后每年 %@。可随时在设置中取消。"
          }
        }
      }
    },
