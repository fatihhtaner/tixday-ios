# Tixday lanes. Authentication uses an App Store Connect API key stored in
# fastlane/AuthKey.json (git-ignored) — see docs/app-store/fastlane.md.

require "json"

default_platform(:ios)

# xcpretty crashes on non-ASCII build output when the shell locale isn't UTF-8.
ENV["LANG"] = ENV["LC_ALL"] = "en_US.UTF-8"
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

API_KEY_PATH = File.expand_path("AuthKey.json", __dir__)

platform :ios do
  before_all do
    UI.user_error!("Missing fastlane/AuthKey.json — see docs/app-store/fastlane.md") unless File.exist?(API_KEY_PATH)
    key = JSON.parse(File.read(API_KEY_PATH))
    # Reads the .p8 from disk so the private key never has to be pasted into the JSON.
    app_store_connect_api_key(
      key_id: key["key_id"],
      issuer_id: key["issuer_id"],
      key_filepath: File.expand_path(File.join("..", key["key_filepath"]), __dir__),
      in_house: key.fetch("in_house", false)
    )
  end

  desc "Upload App Store texts from fastlane/metadata"
  lane :metadata do
    # The App Store version must match the builds' version, or the build can't be picked for review.
    version = File.read(File.expand_path("../project.yml", __dir__))[/MARKETING_VERSION:\s*"?([\d.]+)"?/, 1]
    deliver(
      app_version: version,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      force: true,               # no HTML preview / confirmation prompt
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end

  desc "Upload App Store screenshots from fastlane/screenshots (made by tools/make_store_screenshots.swift)"
  lane :screenshots do
    version = File.read(File.expand_path("../project.yml", __dir__))[/MARKETING_VERSION:\s*"?([\d.]+)"?/, 1]
    deliver(
      app_version: version,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end

  desc "Build a Release archive and upload it to TestFlight"
  lane :beta do
    sh("cd .. && xcodegen generate")
    # Simple build numbers: one more than the latest upload of this version (1, 2, 3… for each new version).
    # MARKETING_VERSION in project.yml is the source of truth.
    version = File.read(File.expand_path("../project.yml", __dir__))[/MARKETING_VERSION:\s*"?([\d.]+)"?/, 1]
    UI.user_error!("MARKETING_VERSION not found in project.yml") unless version
    latest = latest_testflight_build_number(version: version, initial_build_number: 0)
    # Passed to xcodebuild instead of agvtool, which would write the number into the Info.plist files.
    build_number = latest + 1
    build_app(
      project: "Tixday.xcodeproj",
      scheme: "Tixday",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{build_number}",
      output_directory: "build/fastlane"
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
